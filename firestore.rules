rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'ZG.ARNAUD@gmail.com' && request.auth.token.email_verified == true);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for test connection probe
    match /test/connection {
      allow read: if true;
    }

    // 2. Users Collection
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'photoURL', 'createdAt']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 120 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40));
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 3. Appointments Collection
    function isValidAppointment(data) {
      return data.keys().hasAll(['confirmationCode', 'fullName', 'phone', 'specialtyName', 'date', 'time', 'status']) &&
             data.keys().hasOnly(['confirmationCode', 'fullName', 'phone', 'email', 'specialtyId', 'specialtyName', 'doctorId', 'doctorName', 'date', 'time', 'notes', 'status', 'userId', 'createdAt']) &&
             data.confirmationCode is string && data.confirmationCode.size() <= 50 && data.confirmationCode.matches('^[a-zA-Z0-9\\-]+$') &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 25 &&
             data.specialtyName is string && data.specialtyName.size() <= 100 &&
             data.date is string && data.date.size() <= 15 &&
             data.time is string && data.time.size() <= 10 &&
             (data.status == 'confirme' || data.status == 'annule' || data.status == 'termine') &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('specialtyId' in data) || (data.specialtyId is string && data.specialtyId.size() <= 50)) &&
             (!('doctorId' in data) || (data.doctorId is string && data.doctorId.size() <= 50)) &&
             (!('doctorName' in data) || (data.doctorName is string && data.doctorName.size() <= 100)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40));
    }

    match /appointments/{appointmentId} {
      allow get: if isValidId(appointmentId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(appointmentId) && isValidAppointment(incoming()) &&
                   (!('userId' in incoming()) || !isSignedIn() || incoming().userId == request.auth.uid);
      allow update: if isValidId(appointmentId) && isValidAppointment(incoming()) &&
                   (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid)) &&
                   incoming().confirmationCode == existing().confirmationCode;
      allow delete: if isValidId(appointmentId) && isAdmin();
    }

    // 4. Contact Messages Collection
    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message']) &&
             data.keys().hasOnly(['name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt']) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 120 &&
             data.message is string && data.message.size() >= 5 && data.message.size() <= 1000 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 25)) &&
             (!('subject' in data) || (data.subject is string && data.subject.size() <= 150)) &&
             (!('status' in data) || (data.status == 'nouveau' || data.status == 'traite')) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40));
    }

    match /contact_messages/{messageId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(messageId) && isValidContactMessage(incoming());
      allow update: if isValidId(messageId) && isAdmin() && isValidContactMessage(incoming());
      allow delete: if isValidId(messageId) && isAdmin();
    }
  }
}
